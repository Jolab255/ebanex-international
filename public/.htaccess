DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Exclude sitemap.xml and robots.txt explicitly from rewrites
  RewriteRule ^(sitemap\.xml|robots\.txt)$ - [L]
  
  # If the request is for a real file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Otherwise, send everything else to index.html
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Do not cache index.html
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache assets for 1 year
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
